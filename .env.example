# ── База данных ──────────────────────────────────────────────
DATABASE_URL="postgresql://profai:profai@localhost:5432/profai?schema=public"

# ── Очередь задач ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── LLM-провайдер (зарубежный: OpenAI / Anthropic) ──────────
# Провайдер спрятан за адаптером (packages/shared + apps/api/src/llm),
# сменить можно без переписывания бизнес-логики.
LLM_PROVIDER="anthropic"           # anthropic | openai
LLM_API_KEY=""
LLM_MODEL="claude-opus-4-8"        # для openai напр. gpt-4.1

# ── Приложение ───────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN="http://localhost:5173"

# ⚠️ 152-ФЗ: чувствительные ПД уходят в зарубежный LLM.
# Обязателен явный пользовательский консент (хранится в test_sessions.consentAt),
# в промпт LLM передаются только открытые ответы и агрегированные баллы,
# без прямых идентификаторов (город/точный доход/имя) сверх необходимого.
