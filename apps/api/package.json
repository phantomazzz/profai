{
  "name": "@profai/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "serve": "dotenv -e ../../.env -- tsx src/server.ts",
    "serve:prod": "tsx src/server.ts",
    "gen": "dotenv -e ../../.env -- tsx src/scripts/gen-report.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@prisma/client": "^5.22.0",
    "@profai/shared": "*",
    "ajv": "^8.17.1",
    "bullmq": "^5.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^7.4.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
